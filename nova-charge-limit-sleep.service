[Unit]
Description=Pause charging at the limit before sleep (nova-charge-limit)
Before=sleep.target
ConditionPathExists=/etc/nova-charge-limit.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /var/lib/nova-charge-limit/bin/nova-charge-limit sleep

[Install]
WantedBy=sleep.target