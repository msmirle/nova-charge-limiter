#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Caps battery charging on Qualcomm handhelds running Armada OS, such as the
# Retroid Pocket Nova. Where the charger firmware honours the charge
# thresholds it enforces the limit itself. Where it ignores them (as on the
# Nova), this pauses and resumes charging through the battery charge current
# limit (constant_charge_current) as the battery level crosses the limit.
set -uo pipefail

version=1.4.0-rc.1
sys_root=${NOVA_CHARGE_LIMIT_SYS_ROOT:-/sys}
config=${NOVA_CHARGE_LIMIT_CONFIG:-/etc/nova-charge-limit.conf}
state_file=${NOVA_CHARGE_LIMIT_STATE:-/run/nova-charge-limit/state}
# Left by "sleep" when it pauses charging, for the service to pick up.
sleep_pause_file=$state_file.sleep-pause
installed=/var/lib/nova-charge-limit/bin/nova-charge-limit
interval=${NOVA_CHARGE_LIMIT_INTERVAL:-30}
retry_delay=${NOVA_CHARGE_LIMIT_RETRY_DELAY:-2}
service_wait=${NOVA_CHARGE_LIMIT_SERVICE_WAIT:-30}
# How long one-shot commands wait for the charger firmware to apply a change.
settle=${NOVA_CHARGE_LIMIT_SETTLE:-10}
sleep_settle=${NOVA_CHARGE_LIMIT_SLEEP_SETTLE:-3}
poll_delay=${NOVA_CHARGE_LIMIT_POLL_DELAY:-1}
# Tests only: stop "run" after this many checks.
max_ticks=${NOVA_CHARGE_LIMIT_MAX_TICKS:-0}
sudo_bin=${NOVA_CHARGE_LIMIT_SUDO:-sudo}
systemctl_bin=${NOVA_CHARGE_LIMIT_SYSTEMCTL:-systemctl}
journalctl_bin=${NOVA_CHARGE_LIMIT_JOURNALCTL:-journalctl}
# The user's Armada sleep settings, and the copy suspend-dispatch reads
# instead (see nova-charge-limit-suspend.conf).
armada_sleep_config=${NOVA_CHARGE_LIMIT_ARMADA_SLEEP_CONFIG:-/etc/armada/sleep.conf}
sleep_config=${NOVA_CHARGE_LIMIT_SLEEP_CONFIG:-/run/nova-charge-limit-sleep.conf}
# Armada's fake-suspend state.
armada_run=${NOVA_CHARGE_LIMIT_ARMADA_RUN:-/run/armada}
handoff_file=$state_file.handoff
handoff_wait=${NOVA_CHARGE_LIMIT_HANDOFF_WAIT:-30}
handoff_poll=${NOVA_CHARGE_LIMIT_HANDOFF_POLL:-0.2}
service=nova-charge-limit.service
sleep_marker='# nova-charge-limit: charging toward the limit'

# Ranges the qcom_battmgr driver accepts (it silently clamps anything else).
limit_min=55 limit_max=100
resume_min=50 resume_max=95
default_gap=5
# The service does not restart after this status: the device can't limit charging.
exit_unsupported=3

prog=${0##*/}
battery='' method='' charging='' pause_capacity='' warned=0 sleep_pid=''
# The charging state last asked of the firmware, and how many checks in a row
# the firmware has reported something else.
requested='' mismatch=0
# Deep sleep bookkeeping for the current fake suspend.
deep_blocked=0

log() { echo "$prog: $*" >&2; }
die() { log "$*"; exit 1; }

usage() {
    cat <<EOF
Usage: $prog <command>

Commands:
  status              Show the battery, the configured limit and how it is enforced
  set LIMIT [RESUME]  Save and apply a new limit ($limit_min-$limit_max%); charging
                      resumes below RESUME ($resume_min-$resume_max%, default LIMIT-$default_gap)
  off                 Charge to 100% again (same as: set 100)
  deep-sleep on|off   Experimental: switch from fake suspend to real sleep once
                      the battery reaches the limit while sleeping on the charger
  apply               Re-apply the limit saved in $config
  reset               Lift any limit right now, without changing the saved one
  run                 Enforce the limit continuously (used by the service)
  sleep               Prepare for system sleep (run by systemd-suspend.service)
  sleep-finished      Mark the end of a managed sleep cycle (used by systemd)

All commands except status need root and ask for your password through sudo.
EOF
}

# sudo can't find this command (its PATH is fixed to read-only system
# folders), so elevate by absolute path instead.
require_root() {
    if ((EUID == 0)) || [[ ${NOVA_CHARGE_LIMIT_ALLOW_NONROOT:-0} == 1 ]]; then
        return 0
    fi
    command -v "$sudo_bin" >/dev/null || die "this command needs root; run it as root"
    exec "$sudo_bin" -- "$(readlink -f -- "$0")" "$@"
}

is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

is_percent() { [[ $1 =~ ^[0-9]{1,3}$ ]]; }

read_attr() { tr -d '\0\n' <"$1" 2>/dev/null; }

write_attr() { printf '%s\n' "$2" 2>/dev/null >"$1"; }

has_control() { [[ -e $1/charge_control_end_threshold || -e $1/constant_charge_current ]]; }

external_power_online() {
    local supply

    for supply in "$sys_root"/class/power_supply/*; do
        [[ $(read_attr "$supply/type") == Battery ]] && continue
        [[ $(read_attr "$supply/online") == 1 ]] && return 0
    done
    return 1
}

find_battery() {
    local supply="$sys_root/class/power_supply/battery"

    if has_control "$supply"; then
        printf '%s' "$supply"
        return 0
    fi
    for supply in "$sys_root"/class/power_supply/*; do
        if [[ $(read_attr "$supply/type") == Battery ]] && has_control "$supply"; then
            printf '%s' "$supply"
            return 0
        fi
    done
    return 1
}

load_config() {
    local line key value
    local re='^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*"?([^"[:space:]]*)"?[[:space:]]*$'

    cfg_limit='' cfg_resume='' cfg_deep=no
    [[ -r $config ]] || die "cannot read $config"
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
        [[ $line =~ $re ]] || die "$config: cannot parse line: $line"
        key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
        case $key in
            CHARGE_LIMIT) cfg_limit=$value ;;
            CHARGE_RESUME) cfg_resume=$value ;;
            DEEP_SLEEP_AT_LIMIT)
                case ${value,,} in
                    yes | on | true | 1) cfg_deep=yes ;;
                    no | off | false | 0 | '') cfg_deep=no ;;
                    *) die "$config: DEEP_SLEEP_AT_LIMIT must be yes or no, got '$value'" ;;
                esac
                ;;
            *) log "$config: ignoring unknown setting $key" ;;
        esac
    done <"$config"
    [[ -n $cfg_limit ]] || die "$config: CHARGE_LIMIT is not set"
}

# The saved deep sleep setting, or "no" if the config is missing or invalid.
saved_deep_sleep() {
    (load_config >/dev/null 2>&1 && printf '%s' "$cfg_deep") || printf no
}

# Sets target_limit/target_resume, filling in the default resume point.
resolve_thresholds() {
    local limit=$1 resume=${2-}

    if ! is_percent "$limit" || ((10#$limit < limit_min || 10#$limit > limit_max)); then
        die "the limit must be $limit_min-$limit_max, got '$limit'"
    fi
    target_limit=$((10#$limit))

    if [[ -z $resume ]]; then
        target_resume=$((target_limit - default_gap))
        ((target_resume >= resume_min)) || target_resume=$resume_min
        return 0
    fi
    if ! is_percent "$resume" || ((10#$resume < resume_min || 10#$resume > resume_max)); then
        die "the resume point must be $resume_min-$resume_max, got '$resume'"
    fi
    target_resume=$((10#$resume))
    ((target_resume < target_limit)) ||
        die "the resume point ($target_resume) must be below the limit ($target_limit)"
}

write_config() {
    local limit=$1 resume=$2 deep=$3 tmp

    tmp=$(mktemp "$config.XXXXXX" 2>/dev/null) || die "cannot write $config"
    if ! cat >"$tmp" <<EOF; then
# nova-charge-limit settings. Change them with: nova-charge-limit set LIMIT [RESUME]

# Charging stops once the battery reaches this percentage ($limit_min-$limit_max).
CHARGE_LIMIT=$limit

# Charging starts again once the battery drops below this percentage
# ($resume_min-$resume_max). Leave empty to resume $default_gap% below CHARGE_LIMIT.
CHARGE_RESUME=$resume

# Experimental (yes/no). While asleep on the charger, the Nova uses fake
# suspend until the battery reaches CHARGE_LIMIT. "yes" then switches to real
# sleep to save power. Change it with: nova-charge-limit deep-sleep on|off
DEEP_SLEEP_AT_LIMIT=$deep
EOF
        rm -f "$tmp"
        die "cannot write $config"
    fi
    if ! chmod 644 "$tmp" || ! mv -f "$tmp" "$config"; then
        rm -f "$tmp"
        die "cannot write $config"
    fi
}

# --- Charger firmware thresholds ---------------------------------------------

thresholds_hold() {
    local battery=$1 start_attr="$1/charge_control_start_threshold"

    [[ -e $battery/charge_control_end_threshold ]] || return 1
    [[ $(read_attr "$battery/charge_control_end_threshold") == "$2" ]] || return 1
    [[ ! -e $start_attr || $(read_attr "$start_attr") == "$3" ]]
}

# Some firmware (the Nova's) accepts these writes but ignores them, and the
# driver reports success either way; only a matching read-back counts.
apply_thresholds() {
    local battery=$1 limit=$2 resume=$3 attempt
    local start_attr="$battery/charge_control_start_threshold"

    [[ -e $battery/charge_control_end_threshold ]] || return 1
    for attempt in 1 2 3; do
        # Raising the end threshold keeps the old resume point, so the start
        # write that follows is what pins the resume point.
        write_attr "$battery/charge_control_end_threshold" "$limit"
        [[ ! -e $start_attr ]] || write_attr "$start_attr" "$resume"
        thresholds_hold "$battery" "$limit" "$resume" && return 0
        ((attempt == 3)) || sleep "$retry_delay"
    done
    return 1
}

# --- Battery charge current limit (0 pauses charging, USB still powers the device)
#
# The charger firmware applies a new charge current on its own schedule. It
# acknowledges the write straight away but reads back the previous value for
# a while (on the Nova: 7200000 just after writing 0). So a change only counts
# as failed if it still hasn't shown up after a few checks.

current_max() {
    local max

    max=$(read_attr "$1/constant_charge_current_max")
    if ! is_uint "$max" || ((max == 0)); then
        return 1
    fi
    printf '%s' "$max"
}

current_supported() { [[ -e $1/constant_charge_current ]] && current_max "$1" >/dev/null; }

# What the charger firmware currently reports: paused, allowed or unknown.
# Any non-zero current counts as allowed; the firmware may report less than
# constant_charge_current_max (e.g. 7000000 of 7200000).
firmware_state() {
    local current

    current=$(read_attr "$1/constant_charge_current")
    if ! is_uint "$current"; then
        echo unknown
    elif ((current == 0)); then
        echo paused
    else
        echo allowed
    fi
}

firmware_paused() { [[ $(firmware_state "$1") == paused ]]; }

# Logs the kernel's reason when the write itself fails.
write_current() {
    local err

    if err=$({ printf '%s\n' "$2" >"$1/constant_charge_current"; } 2>&1); then
        return 0
    fi
    log "writing $2 to constant_charge_current failed: ${err##*: }"
    return 1
}

request() {
    local max

    if [[ $2 == paused ]]; then
        write_current "$1" 0
    else
        max=$(current_max "$1") || return 1
        write_current "$1" "$max"
    fi
}

# For one-shot commands: request a state and wait up to $3 seconds for the
# firmware to report it.
request_and_wait() {
    local battery=$1 want=$2 deadline=$((SECONDS + $3))

    request "$battery" "$want" || return 2
    until [[ $(firmware_state "$battery") == "$want" ]]; do
        ((SECONDS < deadline)) || return 1
        sleep "$poll_delay"
    done
}

# --- Service -----------------------------------------------------------------

read_state() { sed -n "s/^$1=//p" "$state_file" 2>/dev/null | head -n 1; }

service_running() {
    local pid

    pid=$(read_state pid)
    [[ -n $pid && -d /proc/$pid ]]
}

write_state() {
    local tmp="$state_file.$$"

    if { printf 'pid=%s\n' "$$" && printf '%s\n' "$@"; } >"$tmp" 2>/dev/null; then
        mv -f "$tmp" "$state_file" 2>/dev/null && return 0
    fi
    rm -f "$tmp"
}

detect_method() {
    if apply_thresholds "$battery" "$target_limit" "$target_resume"; then
        method=firmware
        log "the charger firmware enforces the limit: stops at $target_limit%, resumes below $target_resume%"
        return 0
    fi
    if current_supported "$battery"; then
        method=current
        log "the charger firmware ignored the charge thresholds" \
            "(reads back end=$(read_attr "$battery/charge_control_end_threshold" || echo '?'));" \
            "pausing charging at $target_limit% and resuming below $target_resume% instead"
        return 0
    fi
    log "this battery has no working charge control: the charger firmware ignored the" \
        "charge thresholds and constant_charge_current is unavailable"
    exit "$exit_unsupported"
}

check_firmware() {
    thresholds_hold "$battery" "$target_limit" "$target_resume" && return 0
    log "the charge thresholds were reset (e.g. by sleep); applying them again"
    apply_thresholds "$battery" "$target_limit" "$target_resume" && return 0
    if current_supported "$battery"; then
        method=current
        log "the charger firmware no longer accepts the charge thresholds; pausing charging instead"
    else
        log "could not restore the charge thresholds"
    fi
}

check_current() {
    local capacity=$1 force_pause=${2-} want firmware

    if ! is_uint "$capacity"; then
        log "cannot read the battery level"
        return 0
    fi
    firmware=$(firmware_state "$battery")
    # Before the first request, take over whatever the firmware is doing.
    [[ -n $requested ]] || [[ $firmware == unknown ]] || requested=$firmware
    # "nova-charge-limit sleep" paused charging while this service wasn't looking.
    if [[ -e $sleep_pause_file ]]; then
        rm -f "$sleep_pause_file"
        requested=paused pause_capacity=$capacity warned=0
    fi

    if [[ -n $force_pause ]]; then
        want=paused
    elif ((target_limit >= limit_max)); then
        want=allowed
    elif ((capacity >= target_limit)); then
        want=paused
    elif ((capacity < target_resume)); then
        want=allowed
    elif [[ $requested == paused ]]; then
        want=paused
    else
        want=allowed
    fi

    if [[ $want != "$requested" ]]; then
        if request "$battery" "$want"; then
            requested=$want mismatch=0
            if [[ $want == paused ]]; then
                log "battery at $capacity%: ${force_pause:-charging paused}"
                pause_capacity=$capacity warned=0
            else
                log "battery at $capacity%: charging resumed"
            fi
        fi
    elif [[ $firmware != "$requested" ]]; then
        # Not applied yet, or reset by the firmware (e.g. on plugging in).
        if ((++mismatch == 3)); then
            log "the charger firmware still reports charging $firmware after 3 checks" \
                "(constant_charge_current reads $(read_attr "$battery/constant_charge_current" || echo '?'));" \
                "asking for $requested again at every check"
        fi
        request "$battery" "$requested"
    elif ((mismatch)); then
        ((mismatch < 3)) || log "the charger firmware now reports charging $requested"
        mismatch=0
    fi

    if [[ $requested == paused ]]; then
        [[ -n $pause_capacity ]] || pause_capacity=$capacity
        if ((!warned && capacity > pause_capacity + 1)); then
            log "warning: the battery rose from $pause_capacity% to $capacity% while charging" \
                "was paused; the charger firmware may ignore the charge current limit"
            warned=1
        fi
    else
        pause_capacity=''
    fi
}

check() {
    local capacity

    capacity=$(read_attr "$battery/capacity")
    [[ $method == firmware ]] && check_firmware
    if [[ $method == current ]]; then
        if deep_sleep_context && ! external_power_online; then
            # A charger plugged in during real sleep must not charge past the limit.
            check_current "$capacity" "charger unplugged during sleep: charging paused"
        else
            check_current "$capacity"
        fi
        charging=${requested:-unknown}
    else
        charging=firmware
    fi
    write_state "version=$version" "method=$method" "limit=$target_limit" "resume=$target_resume" \
        "capacity=$capacity" "charging=$charging" "firmware=$(firmware_state "$battery")"
}

# --- Deep sleep at the limit (experimental, DEEP_SLEEP_AT_LIMIT=yes) ----------
#
# While the Nova sleeps on the charger, it stays in Armada's fake suspend so
# this service can stop charging at the limit. Once charging is paused, real
# sleep saves power. First finish fake suspend, including Armada's resume
# work, then request a new systemd sleep cycle. Never nest a raw kernel
# suspend inside the still-running fake-suspend service.

fake_suspend_active() { [[ -e $armada_run/fake-suspend.active ]]; }

configured_for_fake_sleep() {
    local line mode=s2idle

    [[ -r $armada_sleep_config ]] || return 1
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ ^[[:space:]]*suspend_mode[[:space:]]*=[[:space:]]*(fake|s2idle)[[:space:]]*$ ]]; then
            mode=${BASH_REMATCH[1]}
        fi
    done <"$armada_sleep_config"
    [[ $mode == fake ]]
}

# Only for a fake suspend that "nova-charge-limit sleep" chose, never for one
# the user set up in /etc/armada/sleep.conf or that started some other way.
fake_suspend_is_ours() {
    local flag_time config_time

    grep -qxF -- "$sleep_marker" "$sleep_config" 2>/dev/null || return 1
    flag_time=$(stat -c %Y -- "$armada_run/fake-suspend.active" 2>/dev/null) || return 1
    config_time=$(stat -c %Y -- "$sleep_config" 2>/dev/null) || return 1
    ((flag_time >= config_time && flag_time - config_time <= 60))
}

deep_sleep_context() {
    [[ $cfg_deep == yes && $method == current ]] || return 1
    ((target_limit < limit_max)) || return 1
    if ! fake_suspend_active; then
        # A new fake suspend starts with a clean slate.
        deep_blocked=0
        return 1
    fi
    fake_suspend_is_ours
}

deep_sleep_ready() {
    deep_sleep_context || return 1
    ((!deep_blocked)) || return 1
    configured_for_fake_sleep && return 1
    # Only once the firmware confirms the pause: real sleep can't watch the battery.
    [[ $requested == paused ]] && firmware_paused "$battery" || return 1
    grep -qw s2idle "$sys_root/power/mem_sleep" 2>/dev/null
}

handoff_phase() {
    local owner phase

    [[ -r $handoff_file ]] || return 0
    read -r owner phase <"$handoff_file" || return 0
    [[ $owner == "$(read_state pid)" && -d /proc/$owner ]] || return 0
    printf '%s' "$phase"
}

write_handoff() {
    local phase=$1 owner=${2:-$$} tmp="$handoff_file.$BASHPID"

    if printf '%s %s\n' "$owner" "$phase" >"$tmp" && mv -f -- "$tmp" "$handoff_file"; then
        return 0
    fi
    rm -f -- "$tmp"
    log "could not record the managed sleep handoff"
    return 1
}

sleep_cycle_finished() {
    local unit state

    fake_suspend_active && return 1
    for unit in systemd-suspend.service suspend.target sleep.target; do
        state=$("$systemctl_bin" show -p ActiveState --value "$unit") || return 1
        [[ $state == inactive ]] || return 1
    done
}

deep_sleep() {
    local deadline token current_token error phase polls=0

    deep_blocked=1
    # Do not compete with an already requested wake.
    [[ ! -e $armada_run/fake-suspend.wake ]] || return 0
    token=$(stat -c '%i:%y' -- "$armada_run/fake-suspend.active") || return 0
    log "charging paused: finishing fake suspend before requesting managed real sleep"
    if ! (set -o noclobber; : >"$armada_run/fake-suspend.wake") 2>/dev/null; then
        log "could not request the end of fake suspend; not entering real sleep"
        return 0
    fi
    deadline=$((SECONDS + handoff_wait))
    until sleep_cycle_finished; do
        current_token=$(stat -c '%i:%y' -- "$armada_run/fake-suspend.active" 2>/dev/null) || current_token=''
        if [[ -n $current_token && $current_token != "$token" ]]; then
            log "a new fake suspend started during the handoff; cancelling real sleep"
            return 0
        fi
        if ((SECONDS >= deadline)); then
            log "fake suspend did not finish cleanly; not entering real sleep"
            return 0
        fi
        sleep "$handoff_poll"
    done
    # A power-policy daemon failure must not be hidden by another suspend.
    if ! "$systemctl_bin" is-active --quiet armada-powerd.service; then
        log "armada-powerd is not running after fake suspend; cancelling real sleep"
        return 0
    fi
    if ! firmware_paused "$battery"; then
        log "the firmware no longer confirms charging is paused; cancelling real sleep"
        return 0
    fi
    write_handoff requested || return 0
    log "fake suspend finished; requesting real sleep through systemd"
    if ! error=$("$systemctl_bin" --no-block suspend 2>&1); then
        rm -f -- "$handoff_file"
        log "systemd refused managed real sleep: $error"
        return 0
    fi
    while :; do
        phase=$(handoff_phase)
        case $phase in
            finished)
                rm -f -- "$handoff_file"
                log "managed real sleep cycle finished; returning to awake charging rules"
                return 0
                ;;
            requested | started) ;;
            *)
                rm -f -- "$handoff_file"
                log "managed real sleep was cancelled; leaving the device awake"
                return 0
                ;;
        esac
        # Count awake polls rather than wall time: SECONDS can jump over
        # hours spent asleep before systemd gets to its post-sleep hook.
        if ((polls++ >= handoff_wait * 5)); then
            rm -f -- "$handoff_file"
            log "managed sleep did not complete its lifecycle in time; not requesting another sleep"
            return 0
        fi
        sleep "$handoff_poll"
    done
}

# Never leave charging paused once nothing is watching the battery.
restore_charging() {
    [[ $method == current ]] || return 0
    [[ $requested == paused ]] || firmware_paused "$battery" || return 0
    case $(request_and_wait "$battery" allowed "$settle"; echo $?) in
        0) log "charging allowed again" ;;
        1) log "asked the charger firmware to allow charging again; it hasn't confirmed yet" ;;
    esac
}

on_signal() {
    [[ -z $sleep_pid ]] || kill "$sleep_pid" 2>/dev/null
    rm -f -- "$handoff_file"
    restore_charging
    exit 0
}

cmd_run() {
    local capacity ticks=0 waiting=0

    load_config
    resolve_thresholds "$cfg_limit" "$cfg_resume"
    trap on_signal TERM INT
    rm -f -- "$handoff_file"
    log "version $version started"

    # The battery only reports once the charger firmware is up, which can lag boot.
    while :; do
        if battery=$(find_battery); then
            capacity=$(read_attr "$battery/capacity")
            is_uint "$capacity" && break
        fi
        ((waiting++)) || log "waiting for the battery"
        sleep 2
    done

    detect_method
    while :; do
        check
        if ((max_ticks && ++ticks >= max_ticks)); then
            return 0
        fi
        if deep_sleep_ready; then
            deep_sleep
            # Re-check after the managed cycle or a cancelled handoff.
            continue
        fi
        sleep "$interval" &
        sleep_pid=$!
        wait "$sleep_pid"
        sleep_pid=''
    done
}

# Armada's device-env takes the last suspend_mode line, so an appended one
# overrides the user's setting for this sleep only.
write_sleep_config() {
    local tmp="$sleep_config.$$"

    if {
        if [[ -r $armada_sleep_config ]]; then cat -- "$armada_sleep_config"; fi
        if [[ -n ${1-} ]]; then
            printf '\n%s\nsuspend_mode = %s\n' "$sleep_marker" "$1"
        fi
    } >"$tmp" 2>/dev/null && mv -f "$tmp" "$sleep_config" 2>/dev/null; then
        return 0
    fi
    rm -f "$tmp"
    log "cannot write $sleep_config"
}

# Runs just before Armada suspends. Real suspend freezes the service, so
# nothing could stop charging at the limit. While plugged in below the resume
# point, sleep in Armada's fake suspend instead (screen and input off, the
# service keeps running); otherwise pause charging before sleeping.
cmd_sleep() {
    local capacity managed=''

    [[ $(handoff_phase) != requested ]] || managed=yes
    # A handoff is one-shot. A failed pre-sleep check must not affect a later
    # manual suspend.
    [[ -z $managed ]] || write_handoff cancelled "$(read_state pid)"
    write_sleep_config
    if [[ $(read_state method) != current ]] || ! service_running; then
        return 0
    fi
    load_config
    resolve_thresholds "$cfg_limit" "$cfg_resume"
    ((target_limit < limit_max)) || return 0
    battery=$(find_battery) || return 0
    capacity=$(read_attr "$battery/capacity")
    is_uint "$capacity" || return 0

    if [[ -n $managed ]]; then
        if [[ $cfg_deep != yes ]] || configured_for_fake_sleep || ! firmware_paused "$battery" ||
            ! grep -qw s2idle "$sys_root/power/mem_sleep"; then
            log "managed sleep preconditions changed; keeping the configured sleep mode"
            return 0
        fi
        write_sleep_config s2idle || return 1
        write_handoff started "$(read_state pid)" || return 1
        touch "$sleep_pause_file" || return 1
        log "managed handoff: charging pause confirmed; selecting normal s2idle"
        return 0
    fi

    if external_power_online && ((capacity < target_resume)); then
        write_sleep_config fake
        if [[ $cfg_deep == yes ]] && ! configured_for_fake_sleep; then
            log "battery at $capacity% and charging: sleeping in fake suspend until charging stops at" \
                "$target_limit%, then switching to real sleep"
        else
            log "battery at $capacity% and charging: sleeping in fake suspend so charging stops at $target_limit%"
        fi
        return 0
    fi
    if [[ $(firmware_state "$battery") == paused ]]; then
        touch "$sleep_pause_file" 2>/dev/null
        return 0
    fi
    case $(request_and_wait "$battery" paused "$sleep_settle"; echo $?) in
        0) log "battery at $capacity%: charging paused for sleep" ;;
        1) log "battery at $capacity%: asked to pause charging for sleep; the charger firmware hasn't confirmed yet" ;;
        *) return 0 ;;
    esac
    touch "$sleep_pause_file" 2>/dev/null
}

cmd_sleep_finished() {
    [[ $(handoff_phase) == started ]] || return 0
    if [[ ${SERVICE_RESULT:-success} == success ]]; then
        write_handoff finished "$(read_state pid)"
    else
        write_handoff failed "$(read_state pid)"
        log "managed sleep service failed: $SERVICE_RESULT"
    fi
}

cmd_reset() {
    battery=$(find_battery) || die "this device has no battery charge control"
    if [[ -e $battery/charge_control_end_threshold ]]; then
        write_attr "$battery/charge_control_end_threshold" "$limit_max"
        [[ ! -e $battery/charge_control_start_threshold ]] ||
            write_attr "$battery/charge_control_start_threshold" "$resume_max"
    fi
    if current_supported "$battery" && [[ $(firmware_state "$battery") != allowed ]]; then
        case $(request_and_wait "$battery" allowed "$settle"; echo $?) in
            1) log "asked the charger firmware to resume charging; it hasn't confirmed yet" ;;
            2) die "could not resume charging" ;;
        esac
    fi
    log "limit lifted; the battery charges to 100%"
}

service_installed() {
    command -v "$systemctl_bin" >/dev/null && "$systemctl_bin" cat "$service" >/dev/null 2>&1
}

charging_description() {
    local charging firmware

    charging=$(read_state charging) firmware=$(read_state firmware)
    if [[ $charging == paused || $charging == allowed ]] && [[ -n $firmware && $firmware != "$charging" ]]; then
        echo "$charging (waiting for the charger firmware, which still reports $firmware)"
    else
        echo "$charging"
    fi
}

report() {
    local limit resume capacity

    limit=$(read_state limit) resume=$(read_state resume) capacity=$(read_state capacity)
    if ((limit >= limit_max)); then
        echo "No charge limit: the battery charges to 100%."
    elif [[ $(read_state method) == firmware ]]; then
        echo "Charging stops at $limit% and resumes below $resume%; the charger firmware enforces it."
    else
        echo "Charging pauses at $limit% and resumes below $resume%; the service watches the battery."
        echo "Battery is at $capacity%: charging $(charging_description)."
    fi
}

# The service always runs the installed copy, which can differ from this one
# (e.g. ./nova-charge-limit run from an updated git checkout).
check_service_version() {
    local running

    running=$(read_state version)
    [[ $running == "$version" ]] && return 0
    log "warning: the service is running ${running:+version $running}${running:-an older version}" \
        "from $installed, not version $version. To update it, run: sudo bash ./install.sh"
}

# Restart the service with the saved settings and wait for its first check.
activate() {
    local pid deadline

    service_installed || die "the $service service is not installed; run install.sh"
    "$systemctl_bin" restart "$service" || die "could not restart $service"
    deadline=$((SECONDS + service_wait))
    while ((SECONDS < deadline)); do
        pid=$("$systemctl_bin" show -p MainPID --value "$service" 2>/dev/null)
        if [[ -n $pid && $pid != 0 && $(read_state pid) == "$pid" && -n $(read_state charging) ]]; then
            report
            check_service_version
            return 0
        fi
        if ! "$systemctl_bin" is-active --quiet "$service"; then
            log "the service could not apply the limit:"
            "$journalctl_bin" -u "$service" -b -n 5 --no-pager -o cat >&2 2>/dev/null
            exit 1
        fi
        sleep 1
    done
    die "the service did not report back within ${service_wait}s; see: journalctl -u $service"
}

cmd_apply() {
    load_config
    resolve_thresholds "$cfg_limit" "$cfg_resume"
    activate
}

cmd_set() {
    local resume=${2-}

    resolve_thresholds "$1" "$resume"
    find_battery >/dev/null || die "this device has no battery charge control"
    [[ -z $resume ]] || resume=$target_resume
    write_config "$target_limit" "$resume" "$(saved_deep_sleep)"
    activate
}

cmd_deep_sleep() {
    local deep

    case $1 in
        on) deep=yes ;;
        off) deep=no ;;
        *) usage >&2; exit 2 ;;
    esac
    load_config
    resolve_thresholds "$cfg_limit" "$cfg_resume"
    write_config "$cfg_limit" "$cfg_resume" "$deep"
    activate
    if [[ $deep == yes ]]; then
        echo "Deep sleep at the limit: on (experimental). While asleep on the charger, the Nova"
        echo "switches from fake suspend to real sleep once charging pauses at $target_limit%."
    else
        echo "Deep sleep at the limit: off. While asleep on the charger, the Nova stays in fake suspend."
    fi
}

cmd_status() {
    local model capacity state pid end start current max running

    model=$(read_attr "$sys_root/firmware/devicetree/base/model")
    echo "Device:      ${model:-unknown}"

    if [[ -r $config ]]; then
        (load_config && resolve_thresholds "$cfg_limit" "$cfg_resume" &&
            echo "Configured:  stop at $target_limit%, resume below $target_resume% ($config)" &&
            echo "Deep sleep:  $([[ $cfg_deep == yes ]] && echo "on (experimental)" || echo off)") 2>/dev/null ||
            echo "Configured:  invalid ($config)"
    else
        echo "Configured:  none ($config is missing)"
    fi

    if ! battery=$(find_battery); then
        echo "Battery:     no charge control found"
        return 1
    fi
    capacity=$(read_attr "$battery/capacity")
    state=$(read_attr "$battery/status")
    echo "Battery:     ${capacity:-?}% (${state:-unknown}) at $battery"

    pid=$(read_state pid)
    if [[ -n $pid && -d /proc/$pid ]]; then
        case $(read_state method) in
            firmware) echo "Service:     running; the charger firmware enforces the limit" ;;
            current) echo "Service:     running; pauses charging at the limit (firmware ignores charge thresholds)"
                echo "Charging:    $(charging_description)" ;;
            *) echo "Service:     starting" ;;
        esac
        running=$(read_state version)
        if [[ $running == "$version" ]]; then
            echo "Version:     $version"
        else
            echo "Version:     the service runs ${running:-an older version}, this copy is $version" \
                "(update the service with: sudo bash ./install.sh)"
        fi
    else
        echo "Service:     not running (start it with: nova-charge-limit apply)"
        echo "Version:     $version"
    fi

    end=$(read_attr "$battery/charge_control_end_threshold") start=$(read_attr "$battery/charge_control_start_threshold")
    current=$(read_attr "$battery/constant_charge_current") max=$(read_attr "$battery/constant_charge_current_max")
    echo "Raw:         end_threshold=${end:-n/a} start_threshold=${start:-n/a}" \
        "charge_current=${current:-n/a} charge_current_max=${max:-n/a}"
}

case ${1-} in
    status)
        (($# == 1)) || { usage >&2; exit 2; }
        cmd_status
        ;;
    run | sleep | sleep-finished | reset | apply | off)
        (($# == 1)) || { usage >&2; exit 2; }
        require_root "$@"
        case $1 in
            run) cmd_run ;;
            sleep) cmd_sleep ;;
            sleep-finished) cmd_sleep_finished ;;
            reset) cmd_reset ;;
            apply) cmd_apply ;;
            off) cmd_set "$limit_max" ;;
        esac
        ;;
    set)
        (($# == 2 || $# == 3)) || { usage >&2; exit 2; }
        require_root "$@"
        cmd_set "${@:2}"
        ;;
    deep-sleep)
        (($# == 2)) && [[ $2 == on || $2 == off ]] || { usage >&2; exit 2; }
        require_root "$@"
        cmd_deep_sleep "$2"
        ;;
    -h | --help | help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
