#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
set -uo pipefail

state_file=${NOVA_CHARGE_LIMIT_AUDIO_STATE:-/run/nova-charge-limit-audio.state}
runtime_root=${NOVA_CHARGE_LIMIT_AUDIO_RUNTIME:-/run/user}
session_user=${ARMADA_SESSION_USER:-armada}
attempts=5
retry_delay=${NOVA_CHARGE_LIMIT_AUDIO_RETRY_DELAY:-1}
user_command=0

log() { echo "nova-charge-limit-audio: $*" >&2; }

session() {
    if ((user_command)); then
        timeout 2 wpctl "$@"
        return
    fi
    timeout 2 runuser -u "$session_user" -- env \
        XDG_RUNTIME_DIR="$runtime_root/$session_uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_root/$session_uid/bus" \
        wpctl "$@"
}

read_sink() {
    local info

    info=$(session inspect @DEFAULT_AUDIO_SINK@ 2>&1) || {
        error="cannot inspect the default output: $info"
        return 1
    }
    sink_id=$(sed -n 's/^id \([0-9][0-9]*\),.*/\1/p' <<<"$info")
    sink_name=$(sed -n 's/^[[:space:]*]*node\.name = "\(.*\)"$/\1/p' <<<"$info")
    if [[ -z $sink_id || -z $sink_name ]]; then
        error="wpctl inspect did not identify an output node"
        return 1
    fi
}

read_mute() {
    local volume

    volume=$(session get-volume "$sink_id" 2>&1) || {
        error="cannot read mute state: $volume"
        return 1
    }
    if [[ ! $volume =~ ^Volume:[[:space:]]*[0-9] ]]; then
        error="unexpected wpctl get-volume response: $volume"
        return 1
    fi
    muted=0
    [[ $volume != *"[MUTED]"* ]] || muted=1
}

save() {
    local tmp

    # Never restore a snapshot left over from an earlier suspend.
    rm -f -- "$state_file" || return 1
    session_uid=$(id -u "$session_user") || {
        log "cannot find session user $session_user; audio state not saved"
        return 1
    }
    if ! read_sink || ! read_mute; then
        log "$error; audio state not saved"
        return 1
    fi
    tmp=$(mktemp "$state_file.XXXXXX") || return 1
    if ! printf '%s\n' "$session_user" "$session_uid" "$sink_name" "$muted" >"$tmp" ||
        ! mv -f -- "$tmp" "$state_file"; then
        rm -f -- "$tmp"
        log "cannot save audio state to $state_file"
        return 1
    fi
    log "saved output $sink_name (muted=$muted)"
}

restore_once() {
    local reply

    read_sink || return 1
    if [[ $sink_name != "$saved_sink" ]]; then
        log "default output changed to $sink_name; leaving its mute state alone"
        return 0
    fi
    read_mute || return 1
    if [[ $muted == "$saved_mute" ]]; then
        log "output $sink_name has its pre-sleep mute state (muted=$muted)"
        return 0
    fi
    reply=$(session set-mute "$sink_id" "$saved_mute" 2>&1) || {
        error="cannot restore mute state: $reply"
        return 1
    }
    read_mute || return 1
    if [[ $muted != "$saved_mute" ]]; then
        error="output $sink_name did not keep its pre-sleep mute state"
        return 1
    fi
    log "restored output $sink_name (muted=$muted)"
}

restore() {
    local saved_sink saved_mute attempt
    local -a snapshot

    [[ -e $state_file ]] || return 0
    mapfile -t snapshot <"$state_file" || return 1
    rm -f -- "$state_file" || return 1
    if ((${#snapshot[@]} != 4)) || [[ ! ${snapshot[1]} =~ ^[0-9]+$ ||
        -z ${snapshot[0]} || -z ${snapshot[2]} || ! ${snapshot[3]} =~ ^[01]$ ]]; then
        log "invalid audio snapshot; not changing audio"
        return 1
    fi
    session_user=${snapshot[0]} session_uid=${snapshot[1]}
    saved_sink=${snapshot[2]} saved_mute=${snapshot[3]}
    for ((attempt = 1; attempt <= attempts; attempt++)); do
        restore_once && return 0
        ((attempt == attempts)) || sleep "$retry_delay"
    done
    log "audio mute recovery failed after $attempts attempts: $error"
    log "for an unavailable audio device, try: nova-charge-limit audio-recover"
    log "check: journalctl --user -b -u wireplumber -u pipewire -u pipewire-pulse"
    return 1
}

recover() {
    local attempt

    log "restarting this user's audio services; active audio streams will be interrupted"
    if ! timeout 15 systemctl --user restart pipewire.service pipewire-pulse.service wireplumber.service; then
        log "could not restart audio services; run: nova-charge-limit audio-diagnose"
        return 1
    fi
    for ((attempt = 1; attempt <= attempts; attempt++)); do
        if read_sink && read_mute; then
            log "audio services restarted; output $sink_name responds (muted=$muted)"
            log "test playback; this check cannot verify the speakers or DSP"
            return 0
        fi
        ((attempt == attempts)) || sleep "$retry_delay"
    done
    log "audio services restarted but no usable output returned: $error"
    log "run: nova-charge-limit audio-diagnose"
    return 1
}

capture() {
    local result

    printf '\n##'
    printf ' %s' "$@"
    echo
    timeout 8 "$@"
    result=$?
    echo "exit_status=$result"
}

diagnose() {
    echo "Nova charge limiter audio diagnostic (review before sharing)"
    capture date --iso-8601=seconds
    capture uname -r
    capture cat /etc/os-release
    capture cat /proc/asound/cards
    capture wpctl status
    capture wpctl get-volume @DEFAULT_AUDIO_SINK@
    capture systemctl --user --no-pager status pipewire.service pipewire-pulse.service wireplumber.service
    capture journalctl --user -b --no-pager -n 100 -u pipewire -u pipewire-pulse -u wireplumber
    capture journalctl -b --no-pager -n 100 -u nova-charge-limit -u systemd-suspend
    capture journalctl -k -b --no-pager -n 100
}

umask 077
if (($# != 1)); then
    log "usage: $0 save|restore|recover|diagnose"
    exit 2
fi
case ${1-} in
    save | restore)
        if ((EUID != 0)) && [[ ${NOVA_CHARGE_LIMIT_ALLOW_NONROOT:-0} != 1 ]]; then
            log "run the sleep helper as root"
            exit 1
        fi
        "$1"
        ;;
    recover | diagnose)
        if ((EUID == 0)); then
            log "run this command in the logged-in user's terminal, without sudo"
            exit 1
        fi
        user_command=1
        "$1"
        ;;
    *) log "usage: $0 save|restore|recover|diagnose"; exit 2 ;;
esac
